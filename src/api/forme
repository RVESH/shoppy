        const order = await db.prepare("SELECT * FROM orders WHERE order_id=?").bind(order_id).first();
        if (!order) return res({ success:false, message:"Order nahi mila" }, 404);
        if (order.otp_used) return res({ success:false, message:"OTP already used" }, 400);
        if (new Date(order.otp_expires_at) < new Date()) return res({ success:false, message:"OTP expire ho gaya" }, 400);
        if (order.delivery_otp !== otp) return res({ success:false, message:"Galat OTP" }, 400);
        await db.prepare("UPDATE orders SET status='Delivered',otp_used=1 WHERE order_id=?").bind(order_id).run();
        return res({ success:true, message:"Delivered! ✅" });
      }

      return res({ success:false, message:"Route not found: " + path }, 404);

    } catch(e) {
      return res({ success:false, message:"Error: " + e.message }, 500);
    }
  }
};